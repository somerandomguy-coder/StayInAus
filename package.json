{
  "name": "stayinaus-foundation",
  "private": true,
  "version": "0.1.0",
  "description": "AU-Settle Pro foundation: Next.js web + FastAPI backend, with clone reference runtime",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "start": "node local-clone-server.js",
    "start:local": "node local-clone-server.js",
    "build:boundaries": "node scripts/build-boundaries.js",
    "build:labour-market": "python3 apps/api/scripts/extract_abs_labour_market.py",
    "build:industry": "python3 apps/api/scripts/extract_abs_industry_top5.py",
    "check:boundaries": "python3 apps/api/scripts/validate_boundary_consistency.py",
    "dev:web": "npm run dev --workspace @stayinaus/web",
    "build:web": "npm run build --workspace @stayinaus/web",
    "start:web": "npm run start --workspace @stayinaus/web",
    "dev:api": "uvicorn app.main:app --reload --host 127.0.0.1 --port 8000 --app-dir apps/api",
    "test:api": "python3 -m unittest discover -s apps/api/tests -v",
    "check:data": "python3 -m unittest discover -s apps/api/tests -p 'test_data_pipeline.py' -v"
  }
}
